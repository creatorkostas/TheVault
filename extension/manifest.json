{
  "manifest_version": 2,
  "name": "Enthymio Clipper",
  "version": "0.1.0",
  "description": "Save pages, YouTube videos, images, links and notes to your personal Enthymio.",
  "applications": {
    "gecko": {
      "id": "enthymio-clipper@localhost",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "contextMenus",
    "storage",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Save to Enthymio",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon.png",
      "96": "icons/icon.png"
    }
  },
  "icons": {
    "48": "icons/icon.png",
    "96": "icons/icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
